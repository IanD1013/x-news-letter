{
  "name": "x-news-letter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.ts",
    "preview": "vite preview",
    "pipeline": "node --env-file-if-exists=.env scripts/pipeline.ts",
    "notify": "node --env-file-if-exists=.env scripts/notify.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "feed": "^6.0.0",
    "linkify-plugin-hashtag": "^4.3.3",
    "linkify-plugin-mention": "^4.3.3",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
